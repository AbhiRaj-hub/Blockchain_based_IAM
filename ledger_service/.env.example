# Local (non-Docker) development settings. In Docker, the root .env is used instead.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=secureaccess_ledger

VALIDATOR_ID=node-1
# base64 of 32 random bytes:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VALIDATOR_PRIVATE_KEY=
# Optional: public keys of other validator nodes, "node-2:BASE64,node-3:BASE64"
EXTRA_VALIDATOR_PUBLIC_KEYS=

# >= 24 characters; must equal LEDGER_INGEST_API_KEY in identity_service/.env
INGEST_API_KEY=
