# Local (non-Docker) development settings. In Docker, the root .env is used instead.
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=False
# Frontend on a different origin during local dev (python -m http.server 5500):
CORS_ALLOWED_ORIGINS=http://localhost:5500

# Zero-setup dev: USE_SQLITE=True. Otherwise PostgreSQL:
USE_SQLITE=False
POSTGRES_DB=secureaccess_iam
POSTGRES_USER=secureaccess
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

LEDGER_SERVICE_URL=http://localhost:5001
LEDGER_INGEST_API_KEY=         # must equal INGEST_API_KEY in ledger_service/.env
NUM_PROXIES=0                  # 0 when running runserver directly; 1 behind nginx
